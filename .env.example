# Copy to .env at the repo root. Never commit .env.

# --- Server ---
DATABASE_URL=postgres://paradox:change_me@localhost:5432/lead_assistant
PORT=3001
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
AI_PROVIDER=ollama

# --- Client ---
# Vite only reads client/.env, but the default proxy targets /api so no
# client env is required for local development.
# VITE_API_BASE_URL=/api
# Dev-server proxy target for /api (docker-compose sets it to http://server:3001).
# VITE_API_PROXY=http://localhost:3001
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# --- Security ---
# Exact origin allowed for cross-origin browser requests (omit when the Vite
# proxy serves the client same-origin). Example: http://localhost:5173
# CORS_ORIGIN=http://localhost:5173
